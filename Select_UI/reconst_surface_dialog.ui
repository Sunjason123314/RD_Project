      <string notr="true">font-weight: bold;</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QComboBox" name="comboBox">
     <property name="toolTip">
      <string>选择从点云重建三角网格的算法</string>
     </property>
     <item>
      <property name="text">
       <string>Mesh（贪婪三角化）</string>
      </property>
     </item>
     <item>
